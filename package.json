{
  "name": "pixel-office",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "author": "flechys",
  "description": "Pixel art agent visualizer for OpenCode",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "npm run build:next && electron .",
    "build:next": "next build",
    "build:exe": "npm run build:next && electron-builder --win",
    "start": "next start",
    "electron": "electron ."
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^36.9.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.pixeloffice.agent-visualizer",
    "productName": "Pixel Office",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixel Office"
    }
  }
}
